# ==============================================================================
# VERTEX WORK STADIUM ERP // ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Realtime & Cloud Storage Configuration (For Netlify / Cross-device Sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Backend Server Port
PORT=5000

# Relational Database Configuration
# Default: SQLite (data/erp_database.sqlite)
# Optional: Remote/Local PostgreSQL Connection String (uncomment to switch)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vertex_stadium_erp

# Object Storage: Cloudinary (Optional Cloud Uploads)
# Uncomment and fill if you prefer Cloudinary over local disk uploads
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Object Storage: AWS S3 / Cloudflare R2 / S3-Compatible (Optional)
# Uncomment and fill if you prefer AWS S3
# AWS_S3_BUCKET=vertex-erp-media
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
